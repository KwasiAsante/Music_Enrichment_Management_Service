# ─────────────────────────────────────────────────────────────────────────────
#  Music Library Helper Service — environment template
# ─────────────────────────────────────────────────────────────────────────────
#  1. Copy this file to .env:        cp .env.example .env
#  2. Fill in every PLACEHOLDER_ME   (anything left as a placeholder will
#     either fail at startup or fail at runtime when the relevant call is made)
#  3. .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Lidarr ──────────────────────────────────────────────────────────────────
LIDARR_URL=http://PLACEHOLDER_ME
LIDARR_API_KEY=PLACEHOLDER_ME

# ── Prowlarr ────────────────────────────────────────────────────────────────
PROWLARR_URL=http://PLACEHOLDER_ME
PROWLARR_API_KEY=PLACEHOLDER_ME

# ── qBittorrent ─────────────────────────────────────────────────────────────
QBIT_URL=http://PLACEHOLDER_ME
QBIT_USER=PLACEHOLDER_ME
QBIT_PASS=PLACEHOLDER_ME
# Optional — qBittorrent v5.2+ API key (Web UI → Preferences → Web UI).
# When set, username/password are not used for Music Search downloads.
# QBIT_API_KEY=qbt_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
QBIT_SAVE_PATH=/downloads/servarr-downloads

# ── VGMDB (your local vgmdb-api instance) ───────────────────────────────────
VGMDB_URL=http://PLACEHOLDER_ME

# ── Web UI login (Phase 2) ───────────────────────────────────────────────────
# HTTP Basic Auth on the browser-facing pages (/, /mappings, /enrich, /library,
# /logs, /music-search). Every page returns 401 until WEB_UI_PASS is changed
# from PLACEHOLDER_ME — there is no usable default password.
WEB_UI_USER=admin
WEB_UI_PASS=PLACEHOLDER_ME

# ── MusicBrainz ─────────────────────────────────────────────────────────────
# Required by MB's API usage policy. Use a real contact address.
MB_USER_AGENT=MusicLibHelper/1.0 (you@example.com)

# ── Discord webhooks ────────────────────────────────────────────────────────
DISCORD_WEBHOOK_ARTIST=https://discord.com/api/webhooks/PLACEHOLDER_ME
DISCORD_WEBHOOK_ENRICH=https://discord.com/api/webhooks/PLACEHOLDER_ME
DISCORD_WEBHOOK_MB_SEED_DL=https://discord.com/api/webhooks/PLACEHOLDER_ME
DISCORD_WEBHOOK_MB_SEED_BEETS=https://discord.com/api/webhooks/PLACEHOLDER_ME

# ── GitHub Gist (Picard MBID export) ────────────────────────────────────────
GITHUB_TOKEN=PLACEHOLDER_ME
GIST_ID=PLACEHOLDER_ME

# ── Beets ───────────────────────────────────────────────────────────────────
BEET_BIN=/usr/local/bin/beet
# BEETSDIR is set inside the Dockerfile; override here only if you know why.
# BEETSDIR=/config/beets

# ── Schedule (cron format, container TZ is UTC unless overridden) ───────────
SCAN_CRON=0 2 * * 0
ENRICH_CRON=0 3 * * 0
TZ=America/Los_Angeles

# ── Paths inside the container ──────────────────────────────────────────────
# These match the volume mounts in docker-compose.yml — the Python app sees
# the music library at APP_MUSIC_DIR and writes runtime state to APP_DATA_DIR.
# Change them only if you also change the mount targets in docker-compose.yml.
APP_DATA_DIR=/data
APP_MUSIC_DIR=/music

# ── Paths on the host (Docker bind mounts) ──────────────────────────────────
# HOST_MUSIC_DIR is read by docker-compose.yml to know which folder on your
# server to bind-mount into the container at /music. Leave commented to use
# the default `${HOME}/Music`; uncomment and set if your music library lives
# elsewhere (e.g. a NAS mount, an external drive). The path here and
# APP_MUSIC_DIR above must point to the same actual files — the bind mount
# is what makes that true.
# HOST_MUSIC_DIR=/home/kwasi/Music
# HOST_MUSIC_DIR=/storage/music
# HOST_MUSIC_DIR=/mnt/external/synced_music

# ── Service ─────────────────────────────────────────────────────────────────
APP_LOG_LEVEL=INFO
APP_PORT=8900

# ── URL Base ────────────────────────────────────────────────────────────────
# Same idea as Sonarr/Radarr/Lidarr's "URL Base" setting. Leave empty
# (default) to serve at the root. Set to a path like "/music-helper" to
# serve the entire app — UI, API, static assets — under that prefix, so
# a reverse proxy can pass that subpath straight through with no
# rewriting: http://host:8900/music-helper/...
URL_BASE=
